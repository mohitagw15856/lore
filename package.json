{
  "name": "lore-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that turns your group chat's own history into a daily game and a yearly Wrapped. Zero AI, zero API keys, one tap to install.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply lore --local",
    "db:remote": "wrangler d1 migrations apply lore --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/render-samples.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
